    <!-- Account recovery (Settings → Account recovery, and the sign-in screen).
         Both are link-outs to the web account portal: nothing here performs a
         reset. The wording mirrors the portal's own so the two screens do not
         describe the same feature differently — in particular that a recovery
         address restores ACCOUNT ACCESS, and that encrypted notes still need
         the recovery key. -->
    <!-- Deliberately short. This is the state almost every account is in, so
         it is on screen for almost everyone: a two-line bold red paragraph
         here would be the loudest thing in Settings and drown the
         explanation below it. The state gets the emphasis; the mechanism
         ("only while signed in") lives in the neutral description, where it
         is true in every state. -->
    <string name="recovery_no_browser">No browser available</string>
    <string name="forgot_password">Forgot your password?</string>

    <!-- Sign-in screen. Kept here rather than hard-coded in
         activity_auth.xml, so the screen every user sees first can be
