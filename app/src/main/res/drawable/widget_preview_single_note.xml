<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the Pinned Note widget. See
     widget_preview_quick_capture.xml for why previewImage is needed at all. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@drawable/widget_background" />

    <!-- One title rule and a short body block: a single note, not a list. -->
    <item android:top="16dp" android:start="14dp" android:end="40dp" android:height="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFCDD6F4" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:top="40dp" android:start="14dp" android:end="14dp" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF313244" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:top="56dp" android:start="14dp" android:end="14dp" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF313244" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:top="72dp" android:start="14dp" android:end="56dp" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF313244" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_pin"
        android:gravity="top|end"
        android:end="14dp"
        android:top="16dp"
        android:width="14dp"
        android:height="14dp" />

</layer-list>
