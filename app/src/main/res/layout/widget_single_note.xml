<?xml version="1.0" encoding="utf-8"?>
<!-- tools:ignore="UseAppTint": a RemoteViews layout. The launcher inflates it
     without AppCompat, so only android:tint is honoured; the app:tint that
     lint proposes left every widget glyph untinted (white). The full account
     is in the header of widget_quick_capture.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/widget_single_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_single_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/widget_single_pin"
            android:textColor="#FFCDD6F4"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/widget_single_pin"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_pin"
            android:tint="#FFA6ADC8"
            android:visibility="gone"
            android:contentDescription="Pinned" />
    </RelativeLayout>

    <TextView
        android:id="@+id/widget_single_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textColor="#FFA6ADC8"
        android:textSize="13sp"
        android:ellipsize="end"
        android:gravity="top" />

</LinearLayout>
