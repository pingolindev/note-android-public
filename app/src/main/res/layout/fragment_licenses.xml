<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/licensesToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?colorSurface"
        app:title="@string/open_source_licenses"
        app:navigationIcon="@drawable/ic_back" />

    <!-- The notices are a generated asset read from file:///android_asset/,
         never from the network — see LicensesFragment. -->
    <WebView
        android:id="@+id/licensesWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
