<?xml version="1.0" encoding="utf-8"?>
<!-- tools:ignore="UseAppTint": a RemoteViews layout. The launcher inflates it
     without AppCompat, so only android:tint is honoured; the app:tint that
     lint proposes left every widget glyph untinted (white). The full account
     is in the header of widget_quick_capture.xml. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:paddingStart="4dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Color indicator strip.

         ImageView, not View: RemoteViews only accepts classes annotated
         @RemoteView, and `android.view.View` is not one of them — a layout
         containing a bare <View> throws on inflation inside a widget. Nothing
         about the strip changes; `setBackgroundColor` works the same, and it is
         still driven by NoteListRemoteViewsFactory. -->
    <ImageView
        android:id="@+id/widget_item_color"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Pin icon -->
    <ImageView
        android:id="@+id/widget_item_pin"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_pin"
        android:tint="#FFA6ADC8"
        android:visibility="gone"
        android:contentDescription="Pinned" />

    <!-- Title -->
    <TextView
        android:id="@+id/widget_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_item_color"
        android:layout_toStartOf="@id/widget_item_pin"
        android:textColor="#FFCDD6F4"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Body preview -->
    <TextView
        android:id="@+id/widget_item_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_item_title"
        android:layout_toEndOf="@id/widget_item_color"
        android:textColor="#FFA6ADC8"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</RelativeLayout>
