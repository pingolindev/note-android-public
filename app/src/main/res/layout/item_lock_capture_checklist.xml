<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_lock_capture_checklist_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/lockItemChecked"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:importantForAutofill="no" />

    <EditText
        android:id="@+id/lockItemText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/lock_capture_checklist_item_hint"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:importantForAutofill="no"
        android:textColor="#FFECECF4"
        android:textColorHint="#FF8C8FA3"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/lockItemRemove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lock_capture_remove_item"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:tint="#FF8C8FA3" />
</LinearLayout>
