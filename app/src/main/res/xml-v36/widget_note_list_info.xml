<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 16 (API 36) override. Lock-screen widgets are opt-OUT by default
  on 16+, so this list widget — which renders DECRYPTED note titles/snippets
  via NoteListRemoteViewsFactory — would otherwise be readable on the keyguard
  with no authentication. `not_keyguard` keeps it on the home screen only.
  Devices below API 36 fall back to res/xml/ (home_screen).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:initialLayout="@layout/widget_note_list"
    android:widgetCategory="home_screen|not_keyguard"
    android:updatePeriodMillis="1800000"
    android:previewLayout="@layout/widget_note_list"
    android:description="@string/widget_note_list_description" />
