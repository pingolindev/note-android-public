<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 16 (API 36) override. Lock-screen widgets are opt-OUT by default
  on 16+, so this widget — which renders the note's DECRYPTED title and body
  (SingleNoteWidgetProvider reads note.decryptedContent) — would otherwise be
  readable on the keyguard with no authentication. `not_keyguard` keeps it on
  the home screen only. Devices below API 36 fall back to res/xml/ (home_screen).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:initialLayout="@layout/widget_single_note"
    android:widgetCategory="home_screen|not_keyguard"
    android:updatePeriodMillis="1800000"
    android:configure="com.pingolin.note.widget.SingleNoteConfigActivity"
    android:previewLayout="@layout/widget_single_note"
    android:description="@string/widget_single_note_description" />
